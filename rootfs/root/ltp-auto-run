#!/bin/bash
set -e

# Available testcode names:
# basic
# busybox
# cyclictest
# iozone
# iperf
# libcbench
# libctest
# lmbench
# ltp
# lua
# netperf
# unixbench
#
# Example:
# AUTO_RUN_PATTERN='(basic|busybox|ltp)_testcode\.sh$'
# AUTO_RUN_ORDER='basic busybox cyclictest iozone iperf libcbench libctest lmbench lua netperf unixbench ltp'

tree=${LTP_TREE:-both}
pattern=${AUTO_RUN_PATTERN:-'.*_testcode\.sh$'}
order=${AUTO_RUN_ORDER:-'iozone netperf iperf basic busybox cyclictest libcbench libctest lmbench lua unixbench ltp'}

enter_manual_shell() {
    echo
    echo "[ltp-auto-run] auto run cancelled, entering manual shell"
    exec /bin/bash --login
}

enable_interrupt_shell() {
    trap 'enter_manual_shell' INT
}

countdown_or_shell() {
    local secs=${AUTO_RUN_DELAY:-10}

    echo "[ltp-auto-run] press Ctrl-C within ${secs}s to cancel auto run"

    while [ "$secs" -gt 0 ]; do
        printf '\r[ltp-auto-run] starting in %2ds... ' "$secs"
        sleep 1
        secs=$((secs - 1))
    done

    printf '\r[ltp-auto-run] starting now...     \n'
}

pick_bases() {
    case "$tree" in
        musl) printf '%s\n' /mnt/musl ;;
        glibc) printf '%s\n' /mnt/glibc ;;
        both) printf '%s\n' /mnt/musl /mnt/glibc ;;
        *)
            echo "[ltp-auto-run] invalid LTP_TREE=$tree" >&2
            exit 2
            ;;
    esac
}

ltp_runner_for_base() {
    case "$1" in
        /mnt/musl) printf '%s\n' /root/ltp-run-musl ;;
        /mnt/glibc) printf '%s\n' /root/ltp-run-glibc ;;
        *)
            echo "[ltp-auto-run] invalid LTP base=$1" >&2
            return 1
            ;;
    esac
}

pick_ltp_bases() {
    case "$tree" in
        musl) printf '%s\n' /mnt/musl ;;
        glibc) printf '%s\n' /mnt/glibc ;;
        both) printf '%s\n' /mnt/glibc /mnt/musl ;;
        *)
            echo "[ltp-auto-run] invalid LTP_TREE=$tree" >&2
            exit 2
            ;;
    esac
}

run_ltp_phase() {
    local base=$1
    local suites=${2:-}
    local skip_suites=${3:-}
    local testpoints=${4:-}
    local runner

    runner=$(ltp_runner_for_base "$base")
    if [ -n "$testpoints" ]; then
        echo "[ltp-auto-run] running $runner custom testpoints"
        (
            unset LTP_SUITES
            unset LTP_SKIP_SUITES
            LTP_TESTPOINTS="$testpoints" /bin/bash "$runner"
        )
    else
        echo "[ltp-auto-run] running $runner suites=${suites:-default} skip=${skip_suites:-none}"
        (
            unset LTP_TESTPOINTS
            LTP_SUITES="$suites" LTP_SKIP_SUITES="$skip_suites" /bin/bash "$runner"
        )
    fi
}

ltp_group_name_for_base() {
    case "$1" in
        /mnt/musl) printf '%s\n' ltp-musl ;;
        /mnt/glibc) printf '%s\n' ltp-glibc ;;
        *)
            echo "[ltp-auto-run] invalid LTP base=$1" >&2
            return 1
            ;;
    esac
}

run_ltp_sequence_for_base() {
    local ret=0
    local syscalls_file="$1/ltp/runtest/syscalls"
    local syscalls_subset=
    local syscalls_complement=

    case "$1" in
        /mnt/glibc)
            syscalls_subset=$(sed -n '1,132p; 211p; 247p; 248p; 372, 376p; 480p; 543p; 784p; 972p; 1479,1481p; 1520p; 1714p' "$syscalls_file")
            if [ -z "$syscalls_subset" ]; then
                echo "[ltp-auto-run] empty syscalls_subset from $syscalls_file" >&2
                return 1
            fi
            run_ltp_phase "$1" "" "" "$syscalls_subset"
            run_ltp_phase "$1" "fs_bind" ""
            ;;
        /mnt/musl)
            syscalls_subset=$(sed -n '1,132p; 211p; 247p; 248p; 372, 376p; 480p; 543p; 784p; 972p; 1479,1481p; 1520p; 1714p' "$syscalls_file")
            if [ -z "$syscalls_subset" ]; then
                echo "[ltp-auto-run] empty syscalls_subset from $syscalls_file" >&2
                return 1
            fi
            run_ltp_phase "$1" "" "" "$syscalls_subset"
            run_ltp_phase "$1" "fs_bind" ""
            syscalls_complement=$(sed -e '168,189d' -e '1,132d' -e '211d' -e '247d' -e '248d' -e '372,376d' -e '480d' -e '543d' -e '784d' -e '972d' -e '1479,1481d' -e '1520d' -e '1714d' "$syscalls_file")
            if [ -z "$syscalls_complement" ]; then
                echo "[ltp-auto-run] empty syscalls_complement from $syscalls_file" >&2
                return 1
            fi
            run_ltp_phase "$1" "" "" "$syscalls_complement"
            ;;
        *)
            echo "[ltp-auto-run] invalid LTP base=$1" >&2
            return 1
            ;;
    esac

    return "$ret"
}

run_ltp_group() {
    local base=$1
    local group
    local ret

    group=$(ltp_group_name_for_base "$base")
    echo "[ltp-auto-run] running $group sequence"
    echo "#### OS COMP TEST GROUP START $group ####"
    set +e
    run_ltp_sequence_for_base "$base"
    ret=$?
    set -e
    echo "#### OS COMP TEST GROUP END $group ####"
    # return "$ret"
    return 0
}

# 按脚本短名补齐实际测试脚本文件名。
normalize_script_name() {
    local name=$1

    case "$name" in
        *_testcode.sh) printf '%s\n' "$name" ;;
        *) printf '%s_testcode.sh\n' "$name" ;;
    esac
}

# 判断脚本文件名是否匹配当前筛选规则。
script_selected() {
    local script
    script=$(normalize_script_name "$1")
    printf '%s\n' "$script" | grep -E "$pattern" >/dev/null
}

# 打印按用户指定顺序筛选后的脚本列表。
list_ordered_scripts() {
    local item
    local script

    echo "[ltp-auto-run] ordered scripts:"
    for item in $order; do
        script=$(normalize_script_name "$item")
        if script_selected "$script"; then
            echo "  $script"
        fi
    done
}

# 在指定 libc 测试树下运行一个脚本；缺失时跳过。
run_one_script() {
    local base=$1
    local script=$2
    local path="$base/$script"
    local runner

    (
        if [ "$script" = "netperf_testcode.sh" ]; then
            case "$base" in
                /mnt/musl) runner=/root/netperf-run-musl ;;
                /mnt/glibc) runner=/root/netperf-run-glibc ;;
            esac
            echo "[ltp-auto-run] running $runner"
            exec /bin/bash "$runner"
        fi
        if [ "$script" = "iperf_testcode.sh" ]; then
            case "$base" in
                /mnt/musl) runner=/root/iperf-run-musl ;;
                /mnt/glibc) runner=/root/iperf-run-glibc ;;
            esac
            echo "[ltp-auto-run] running $runner"
            exec /bin/bash "$runner"
        fi
        if [ "$script" = "basic_testcode.sh" ]; then
            case "$base" in
                /mnt/musl) runner=/root/basic-run-musl ;;
                /mnt/glibc) runner=/root/basic-run-glibc ;;
            esac
            echo "[ltp-auto-run] running $runner"
            exec /bin/bash "$runner"
        fi
        [ -f "$path" ] || return 0
        echo "[ltp-auto-run] running $path"
        cd "$base"
        /bin/bash "$script"
    )
}

# 按脚本顺序执行测试；LTP 例外，按评测要求先 glibc 后 musl。
run_ordered_scripts() {
    local item
    local script
    local base
    local ret
    local overall_ret=0

    ./loopset loop-fat32.img

    for item in $order; do
        script=$(normalize_script_name "$item")
        if ! script_selected "$script"; then
            continue
        fi
        if [ "$script" = "ltp_testcode.sh" ]; then
            for base in $(pick_ltp_bases); do
                set +e
                run_ltp_group "$base"
                ret=$?
                set -e
                if [ "$ret" -ne 0 ]; then
                    overall_ret="$ret"
                fi
            done
            continue
        fi
        for base in $(pick_bases); do
            run_one_script "$base" "$script"
        done
    done

    return "$overall_ret"
}

enable_interrupt_shell
countdown_or_shell
echo "[ltp-auto-run] tree=$tree pattern=$pattern order=$order"
list_ordered_scripts
run_ordered_scripts
trap - INT
echo "[ltp-auto-run] done"
