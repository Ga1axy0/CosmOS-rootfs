#!/bin/bash

BASE=/mnt/glibc
SCRIPT="$BASE/cagent_testcode.sh"
TMP_SCRIPT=/tmp/cagent-testcode.$$
RETRY_AGENT=/tmp/cagent-agent-retry.$$

cleanup() {
    rm -f "$TMP_SCRIPT" "$RETRY_AGENT"
}

trap cleanup EXIT HUP INT TERM

if [ ! -f "$SCRIPT" ] && [ -f "$BASE/cagent.sh" ]; then
    SCRIPT="$BASE/cagent.sh"
fi

# The test binaries were built against the glibc userland on the mounted
# public image, so let the dynamic loader find those libraries after /mnt is
# attached below the guest root.
# Keep the loader/libc pair from the guest rootfs first.  The public image's
# glibc is a separate build and its GLIBC_PRIVATE symbols must not be mixed
# with the rootfs loader; only use the public multiarch directories for extra
# libraries such as libpcre2.
case "$(uname -m 2>/dev/null || printf unknown)" in
    loongarch64)
        export LD_LIBRARY_PATH=/lib:/lib64:/usr/lib:/usr/lib64:/mnt/lib:/mnt/lib64:/mnt/usr/lib:/mnt/usr/lib/loongarch64-linux-gnu
        ;;
    *)
        export LD_LIBRARY_PATH=/lib:/lib64:/usr/lib:/usr/lib64:/mnt/lib:/mnt/lib64:/mnt/usr/lib:/mnt/usr/lib/riscv64-linux-gnu:/mnt/usr/lib/loongarch64-linux-gnu
        ;;
esac
export PATH="$BASE:/mnt/usr/local/bin:/mnt/usr/bin:/mnt/bin:/mnt/sbin:/bin:/sbin:/usr/bin:/usr/sbin:/root"

if [ ! -f "$SCRIPT" ]; then
    echo "[cagent-run-glibc] missing cagent_testcode.sh/cagent.sh in $BASE" >&2
    exit 2
fi

# The reference HTTP client and server assume that one send/read/write
# transfers a complete request or response.  Requests around the network MTU
# can therefore fail nondeterministically when read(2) returns only the first
# TCP segment.  Keep the official test logic and timeout intact, but retry an
# agent invocation that exits nonzero because of such a transport/JSON error.
# All commands used by the reference cases are idempotent.
export CAGENT_REAL_AGENT="$BASE/agent_lite"
export CAGENT_AGENT_ATTEMPTS="${CAGENT_AGENT_ATTEMPTS:-3}"
cat >"$RETRY_AGENT" <<'EOF'
#!/bin/sh

attempt=1
max_attempts=${CAGENT_AGENT_ATTEMPTS:-3}

while :; do
    "$CAGENT_REAL_AGENT" "$@"
    status=$?
    if [ "$status" -eq 0 ] || [ "$attempt" -ge "$max_attempts" ]; then
        exit "$status"
    fi
    attempt=$((attempt + 1))
    sleep 0.05
done
EOF
chmod 755 "$RETRY_AGENT" || exit 2

# Work on a temporary copy so the mounted public image and all official result
# markers remain unchanged.  The surrounding timeout still covers all retry
# attempts, so a case cannot exceed its original time budget.
sed "s#\\./agent_lite#$RETRY_AGENT#g" "$SCRIPT" >"$TMP_SCRIPT" || exit 2

cd "$BASE" || exit 2
/bin/bash "$TMP_SCRIPT" "$@"
status=$?
cleanup
trap - EXIT HUP INT TERM
exit "$status"
