#!/bin/sh

SCRIPT=/mnt/glibc/buildstorm_testcode.sh
TMP=/tmp/buildstorm-glibc.$$

if [ ! -f "$SCRIPT" ]; then
    echo "[buildstorm-run-glibc] missing $SCRIPT" >&2
    exit 2
fi

trap 'rm -f "$TMP"' EXIT HUP INT TERM

# Cargo's complete host-prepared cache is installed on the guest root disk.
# If an older image only has the seed cache on /mnt, import it first; this is
# idempotent when /root/.cargo already carries the completion marker.
if [ -x /root/prepare-cargo-cache ]; then
    /root/prepare-cargo-cache || exit 1
fi

# Cargo's config file normally supplies this linker, but the buildstorm source
# tree also carries its own .cargo/config.toml. Export target-specific
# variables explicitly so GNU-host build scripts and proc macros cannot fall
# back to the rootfs's musl `cc` when Cargo merges those configurations.
#
# RISC-V keeps using the host-prepared cache on the root disk. LoongArch uses
# the complete Cargo cache already present on the mounted public image, which
# avoids copying it into the much smaller disk-la.img on every snapshot boot.
GUEST_ARCH=$(uname -m 2>/dev/null || printf unknown)
case "$GUEST_ARCH" in
    riscv64)
        GLIBC_HOST_LINKER=${CARGO_GLIBC_HOST_LINKER:-/root/.cargo/bin/riscv64gc-unknown-linux-gnu-gcc}
        BUILDSTORM_CARGO_HOME=/root/.cargo
        BUILDSTORM_LD_LIBRARY_PATH=/lib:/lib64:/usr/lib:/usr/lib64:/mnt/lib/riscv64-linux-gnu:/mnt/usr/lib/riscv64-linux-gnu:/mnt/lib:/mnt/lib64:/mnt/usr/lib:/mnt/usr/lib/loongarch64-linux-gnu
        BUILDSTORM_TARGET_DIR_SED='s#^cd /work/tgoskits#cd /work/tgoskits#'
        export CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_LINKER="$GLIBC_HOST_LINKER"
        export CC_riscv64gc_unknown_linux_gnu="$GLIBC_HOST_LINKER"
        export CC_RISCV64GC_UNKNOWN_LINUX_GNU="$GLIBC_HOST_LINKER"
        ;;
    loongarch64)
        GLIBC_HOST_LINKER=${CARGO_GLIBC_HOST_LINKER:-/root/.cargo/bin/loongarch64-unknown-linux-gnu-gcc}
        BUILDSTORM_CARGO_HOME=/mnt/root/.cargo
        BUILDSTORM_LD_LIBRARY_PATH=/lib:/lib64:/usr/lib:/usr/lib64:/mnt/lib/loongarch64-linux-gnu:/mnt/usr/lib/loongarch64-linux-gnu:/mnt/lib:/mnt/lib64:/mnt/usr/lib
        BUILDSTORM_TARGET_DIR_SED='s#^cd /work/tgoskits#export CARGO_TARGET_DIR=/work/tgoskits/target/.cosmos-la-runtime; cd /work/tgoskits#'
        if [ ! -d "$BUILDSTORM_CARGO_HOME" ]; then
            echo "[buildstorm-run-glibc] missing Cargo home: $BUILDSTORM_CARGO_HOME" >&2
            exit 1
        fi
        export CARGO_TARGET_LOONGARCH64_UNKNOWN_LINUX_GNU_LINKER="$GLIBC_HOST_LINKER"
        export CC_loongarch64_unknown_linux_gnu="$GLIBC_HOST_LINKER"
        export CC_LOONGARCH64_UNKNOWN_LINUX_GNU="$GLIBC_HOST_LINKER"
        ;;
    *)
        echo "[buildstorm-run-glibc] unsupported guest architecture: $GUEST_ARCH" >&2
        exit 1
        ;;
esac

if [ ! -x "$GLIBC_HOST_LINKER" ]; then
    echo "[buildstorm-run-glibc] missing glibc host linker: $GLIBC_HOST_LINKER" >&2
    exit 1
fi
echo "[buildstorm-run-glibc] GNU host linker: $GLIBC_HOST_LINKER"

# The public evaluation image already carries a native debug build of
# tg-xtask.  Reuse it when available: the official test first builds
# tg-xtask outside the timed region and then invokes it through the workspace
# `cargo xtask` alias.  Replacing that invocation in the temporary test copy,
# as well as skipping the explicit pre-build, prevents Cargo from resolving or
# rebuilding tg-xtask inside the formal timed command.
BUILDSTORM_TG_XTASK=/mnt/work/tgoskits/target/debug/tg-xtask
if [ -x "$BUILDSTORM_TG_XTASK" ]; then
    BUILDSTORM_REUSE_TG_XTASK=1
    BUILDSTORM_TG_XTASK_SED="s#cargo xtask arceos build#$BUILDSTORM_TG_XTASK arceos build#"
else
    BUILDSTORM_REUSE_TG_XTASK=0
    BUILDSTORM_TG_XTASK_SED='s#cargo xtask arceos build#cargo xtask arceos build#'
fi
export BUILDSTORM_REUSE_TG_XTASK

# Prefer the glibc userland, compiler utilities, and libraries carried by the
# mounted public image as well as its Rust toolchain.
export LD_LIBRARY_PATH="$BUILDSTORM_LD_LIBRARY_PATH"
if [ -d /mnt/usr/lib/llvm-19/lib ]; then
    export LIBCLANG_PATH=/mnt/usr/lib/llvm-19/lib
fi

# Keep the contest script unchanged on the mounted image, but remap the paths
# that were written for the original standalone rootfs layout.
sed \
    -e 's#^export PATH=.*#export PATH=/root/.cargo/bin:/mnt/root/.cargo/bin:/mnt/usr/local/bin:/mnt/usr/bin:/mnt/bin:/mnt/sbin:/bin:/sbin:/usr/bin:/usr/sbin#' \
    -e "s#^export HOME=.*#export HOME=/root RUSTUP_HOME=/mnt/root/.rustup CARGO_HOME=$BUILDSTORM_CARGO_HOME#" \
    -e "$BUILDSTORM_TARGET_DIR_SED" \
    -e 's#/work/tgoskits#/mnt/work/tgoskits#g' \
    -e 's#/work/.build.rc#/mnt/work/.build.rc#g' \
    -e 's#/work/buildstorm.build.out#/mnt/work/buildstorm.build.out#g' \
    -e 's#^cargo build -p tg-xtask 2>&1 || true$#if [ "${BUILDSTORM_REUSE_TG_XTASK:-0}" = 1 ]; then echo "[buildstorm-run-glibc] reusing tg-xtask: /mnt/work/tgoskits/target/debug/tg-xtask"; else cargo build -p tg-xtask 2>\&1 || true; fi#' \
    -e "$BUILDSTORM_TG_XTASK_SED" \
    "$SCRIPT" > "$TMP" || exit 2

/bin/sh "$TMP" "$@"
status=$?
rm -f "$TMP"
exit "$status"
