#!/bin/bash
set -e

BASE=/mnt/glibc
LTPROOT="$BASE/ltp"
export LTPROOT
export PATH="$LTPROOT/testcases/bin:$LTPROOT/bin:/bin:/usr/bin:/sbin:/usr/sbin"
export LTP_TIMEOUT_MUL=0.2
LTP_RUNNER=${LTP_RUNNER:-serial}
DEFAULT_SUITE_FILE="$LTPROOT/scenario_groups/default"

if [ ! -x "$LTPROOT/runltp" ]; then
    echo "[ltp-run-glibc] missing executable: $LTPROOT/runltp" >&2
    exit 2
fi

cd "$LTPROOT"

normalize_list() {
    printf '%s\n' "$1" | tr ',\n\t' '   ' | tr -s ' '
}

list_contains() {
    local haystack=$1
    local needle=$2

    case " $haystack " in
        *" $needle "*) return 0 ;;
        *) return 1 ;;
    esac
}

default_suite_exists() {
    grep -Fxq -- "$1" "$DEFAULT_SUITE_FILE"
}

has_custom_testpoints() {
    [ -n "${LTP_TESTPOINTS:-}" ]
}

create_custom_testpoints_file() {
    local custom_file

    custom_file=$(mktemp "$LTPROOT/runtest/ltp-custom.XXXXXX")
    printf '%s' "$LTP_TESTPOINTS" > "$custom_file"
    printf '%s\n' "$custom_file"
}

select_existing_suites() {
    local requested=${LTP_SUITES:-}
    local requested_list=
    local skip_list=
    local selected=
    local skipped_requested=
    local skipped_missing=
    local unknown_requested=
    local requested_specified=0
    local suite

    if [ -n "$requested" ]; then
        requested_specified=1
        requested_list=$(normalize_list "$requested")
    fi
    skip_list=$(normalize_list "${LTP_SKIP_SUITES:-}")

    while IFS= read -r suite; do
        case "$suite" in
            ''|\#*) continue ;;
        esac
        if [ "$requested_specified" -eq 1 ] && ! list_contains "$requested_list" "$suite"; then
            continue
        fi
        if list_contains "$skip_list" "$suite"; then
            skipped_requested="$skipped_requested $suite"
            continue
        fi
        if [ -f "$LTPROOT/runtest/$suite" ]; then
            if [ -n "$selected" ]; then
                selected="$selected,$suite"
            else
                selected="$suite"
            fi
        else
            skipped_missing="$skipped_missing $suite"
        fi
    done < "$DEFAULT_SUITE_FILE"

    if [ "$requested_specified" -eq 1 ]; then
        for suite in $requested_list; do
            [ -n "$suite" ] || continue
            if ! default_suite_exists "$suite"; then
                unknown_requested="$unknown_requested $suite"
            fi
        done
    fi

    if [ -n "$unknown_requested" ]; then
        echo "[ltp-run-glibc] ignoring suites not in scenario_groups/default:$unknown_requested" >&2
    fi
    if [ -n "$skipped_requested" ]; then
        echo "[ltp-run-glibc] skipping requested suites:$skipped_requested" >&2
    fi
    if [ -n "$skipped_missing" ]; then
        echo "[ltp-run-glibc] skipping missing runtest suites:$skipped_missing" >&2
    fi
    if [ -z "$selected" ]; then
        echo "[ltp-run-glibc] no runnable LTP suites found" >&2
        exit 2
    fi

    printf '%s\n' "$selected"
}

run_with_runltp() {
    local custom_file=
    if has_custom_testpoints; then
        custom_file=$(create_custom_testpoints_file)
        echo "[ltp-run-glibc] using custom testpoints from LTP_TESTPOINTS; ignoring LTP_SUITES/LTP_SKIP_SUITES" >&2
        set +e
        ./runltp -f "$(basename "$custom_file")"
        ret=$?
        set -e
        rm -f "$custom_file"
        return "$ret"
    fi
    set +e
    ./runltp -f "$LTP_SELECTED_SUITES"
    ret=$?
    set -e
    return "$ret"
}

run_serial() {
    local tmp
    local alltests
    local custom_file=
    local suite
    local tag
    local cmd
    local ret
    local passed=0
    local failed=0
    local skipped=0
    local total=0

    mkdir -p "$LTPROOT/output" "$LTPROOT/results" /tmp
    tmp=$(mktemp -d /tmp/ltp-serial.XXXXXX)
    chmod 777 "$tmp"
    if has_custom_testpoints; then
        custom_file=$(create_custom_testpoints_file)
        alltests="$custom_file"
        echo "[ltp-run-glibc] using custom testpoints from LTP_TESTPOINTS; ignoring LTP_SUITES/LTP_SKIP_SUITES" >&2
    else
        alltests="$tmp/alltests"
        : > "$alltests"

        for suite in $(printf '%s\n' "$LTP_SELECTED_SUITES" | tr ',' ' '); do
            cat "$LTPROOT/runtest/$suite" >> "$alltests"
        done
    fi

    printf 'y\n' | "$LTPROOT/IDcheck.sh" || true

    local line
    while IFS= read -r line; do
        case "$line" in
            ''|\#*) continue ;;
        esac
        if [[ ! "$line" =~ ^[[:space:]]*([^[:space:]]+)[[:space:]]+(.*)$ ]]; then
            continue
        fi
        tag=${BASH_REMATCH[1]}
        cmd=${BASH_REMATCH[2]}
        total=$((total + 1))

        echo "RUN LTP CASE $tag"
        set +e
        (
            cd "$tmp"
            export TMPDIR="$tmp"
            /bin/sh -c "$cmd"
        )
        ret=$?
        set -e

        failed=$((failed + 1))
        echo "FAIL LTP CASE $tag : $ret"
        echo
    done < "$alltests"

    rm -rf "$tmp"
    if [ -n "$custom_file" ]; then
        rm -f "$custom_file"
    fi
    echo "[ltp-run-glibc] total=$total passed=$passed skipped=$skipped failed=$failed"
    # [ "$failed" -eq 0 ]
    return 0
}

if has_custom_testpoints; then
    LTP_SELECTED_SUITES=
else
    LTP_SELECTED_SUITES=$(select_existing_suites)
fi

set +e
case "$LTP_RUNNER" in
    runltp) run_with_runltp ;;
    serial) run_serial ;;
    *)
        echo "[ltp-run-glibc] invalid LTP_RUNNER=$LTP_RUNNER" >&2
        false
        ;;
esac
ret=$?
set -e
exit "$ret"
