#!/bin/sh

# Switch from CosmOS's small bootstrap filesystem to the self-contained
# evaluation filesystem mounted by the kernel at /mnt.

set -u

NEW_ROOT=${COSMOS_NEW_ROOT:-/mnt}
PUT_OLD_NAME=${COSMOS_PUT_OLD_NAME:-.cosmos-old-root}
PUT_OLD="$NEW_ROOT/$PUT_OLD_NAME"
OLD_ROOT="/$PUT_OLD_NAME"

fail() {
    echo "[pivot-eval-root] $*" >&2
    exit 1
}

[ -d "$NEW_ROOT" ] || fail "new root is not mounted: $NEW_ROOT"
[ -x "$NEW_ROOT/bin/sh" ] || fail "new root has no executable /bin/sh"
[ -x "$NEW_ROOT/glibc/cagent_testcode.sh" ] \
    || fail "new root has no CAgent evaluator"
[ -x "$NEW_ROOT/glibc/buildstorm_testcode.sh" ] \
    || fail "new root has no BuildStorm evaluator"
mkdir -p "$PUT_OLD" || fail "cannot create $PUT_OLD"

echo "[pivot-eval-root] switching root to $NEW_ROOT"

moved=""
rollback_mounts() {
    for source_path in $moved; do
        /bin/mount -n --move "$NEW_ROOT$source_path" "$source_path" || true
    done
    moved=""
}

move_mount() {
    source_path=$1
    target_path="$NEW_ROOT$source_path"
    if [ ! -d "$target_path" ]; then
        rollback_mounts
        fail "new root is missing $target_path"
    fi
    # -n suppresses util-linux's userspace mtab/utab update. /proc/mounts is
    # generated by the kernel and is rebased together with the mount tree.
    if ! /bin/mount -n --move "$source_path" "$target_path"; then
        rollback_mounts
        fail "failed to move $source_path to $target_path"
    fi
    moved="$source_path $moved"
}

# Preserve the live pseudo filesystems in the new namespace. Moving /dev also
# carries nested mounts such as /dev/shm.
move_mount /dev
move_mount /proc
move_mount /sys

cd "$NEW_ROOT" || fail "cannot enter $NEW_ROOT"
if ! /sbin/pivot_root . "$PUT_OLD_NAME"; then
    echo "[pivot-eval-root] pivot_root failed; restoring pseudo filesystems" >&2
    cd / || true
    rollback_mounts
    exit 1
fi

cd / || fail "cannot enter the new root"
echo "[pivot-eval-root] root switched; old root is at $OLD_ROOT"

# Keep the existing automatic evaluation entry point, but run the official
# scripts from their native locations in the new root. Copy the tiny runner
# out before lazily detaching the bootstrap filesystem.
RUNNER=/tmp/cosmos-final-auto-run
if [ -x "$OLD_ROOT/root/final_auto_run" ] && [ -x "$OLD_ROOT/bin/busybox" ]; then
    "$OLD_ROOT/bin/busybox" cp "$OLD_ROOT/root/final_auto_run" "$RUNNER" \
        || fail "cannot copy final_auto_run into the new root"
    "$OLD_ROOT/bin/busybox" chmod 0755 "$RUNNER" || true
fi

if [ -x "$OLD_ROOT/bin/busybox" ]; then
    "$OLD_ROOT/bin/busybox" umount -l "$OLD_ROOT" \
        || echo "[pivot-eval-root] warning: old root remains mounted" >&2
fi

HOME=/root
CARGO_HOME=${CARGO_HOME:-/root/.cargo}
RUSTUP_HOME=${RUSTUP_HOME:-/root/.rustup}
export HOME CARGO_HOME RUSTUP_HOME
echo "[pivot-eval-root] Cargo home: $CARGO_HOME"

if [ -x "$RUNNER" ]; then
    CAGENT_RUNNER=/glibc/cagent_testcode.sh
    BUILDSTORM_RUNNER=/glibc/buildstorm_testcode.sh
    CAGENT_WORKDIR=/glibc
    BUILDSTORM_WORKDIR=/glibc
    export CAGENT_RUNNER BUILDSTORM_RUNNER CAGENT_WORKDIR BUILDSTORM_WORKDIR
    exec /bin/sh "$RUNNER" "$@"
fi

if [ -x /sbin/init ]; then
    exec /sbin/init
fi
exec /bin/sh --login
